---
import Layout from '../layouts/Layout.astro';
import HeroLamp from '../components/HeroLamp';
import ContactForm from '../components/ContactForm';
---
<Layout>
  <HeroLamp client:load />
  <section id="contacto" className="relative w-full max-w-7xl mx-auto px-6 py-24 border-t border-neutral-800">
    <div className="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20">
      <div>
        <span className="text-xs font-mono tracking-widest text-neutral-500 uppercase">BD—002 / Project Inquiry</span>
        <h2 className="mt-6 font-sans font-black text-[clamp(40px,6vw,80px)] leading-[0.95] tracking-tight text-[#ecebe6]">
          Hablemos de<br />
          <span className="text-neutral-500">tu proyecto.</span>
        </h2>
        <p className="mt-8 text-neutral-400 font-mono text-sm leading-relaxed max-w-md">
          Si tienes una idea, un producto o un sistema por desarrollar, podemos comenzar a conversar. Respondemos en menos de 24 horas.
        </p>
      </div>
      <div className="flex items-start justify-start md:justify-end">
        <ContactForm client:visible />
      </div>
    </div>
  </section>
</Layout>
